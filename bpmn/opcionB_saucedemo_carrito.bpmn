<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SauceCart"
                  targetNamespace="http://uabc.mx/verificacion/saucedemo">
  <bpmn:process id="Process_SauceCart" name="Catalogo y Carrito - SauceDemo" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Usuario autenticado en catalogo" />
    <bpmn:task id="Task_1" name="Visualizar lista de productos en Inventory" />
    <bpmn:task id="Task_2" name="Clic en 'Add to cart' de un producto" />
    <bpmn:task id="Task_3" name="Verificar incremento en badge del carrito" />
    <bpmn:exclusiveGateway id="Gateway_1" name="Continuar o Quitar producto?" />
    
    <!-- Rama 1: Ir al carrito a revisar compra -->
    <bpmn:task id="Task_4" name="Clic en icono del Carrito" />
    <bpmn:task id="Task_5" name="Verificar producto listado en carrito" />
    <bpmn:endEvent id="EndEvent_1" name="Producto listo para checkout" />
    
    <!-- Rama 2: Quitar producto desde el catalogo -->
    <bpmn:task id="Task_6" name="Clic en boton 'Remove'" />
    <bpmn:task id="Task_7" name="Verificar decremento en badge del carrito" />
    <bpmn:endEvent id="EndEvent_2" name="Producto removido exitosamente" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_5" name="Ver carrito" sourceRef="Gateway_1" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_8" name="Quitar producto" sourceRef="Gateway_1" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_7" targetRef="EndEvent_2" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SauceCart">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <omgdc:Bounds x="60" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="130" y="140" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <omgdc:Bounds x="270" y="140" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <omgdc:Bounds x="410" y="140" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true">
        <omgdc:Bounds x="560" y="155" width="50" height="50" />
      </bpmndi:BPMNShape>
      
      <!-- Shapes Rama 1 -->
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <omgdc:Bounds x="660" y="60" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <omgdc:Bounds x="800" y="60" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <omgdc:Bounds x="940" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Shapes Rama 2 -->
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <omgdc:Bounds x="660" y="240" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <omgdc:Bounds x="800" y="240" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_2_di" bpmnElement="EndEvent_2">
        <omgdc:Bounds x="940" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="96" y="180" />
        <omgdi:waypoint x="130" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="240" y="180" />
        <omgdi:waypoint x="270" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="380" y="180" />
        <omgdi:waypoint x="410" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <omgdi:waypoint x="520" y="180" />
        <omgdi:waypoint x="560" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <omgdi:waypoint x="585" y="155" />
        <omgdi:waypoint x="585" y="100" />
        <omgdi:waypoint x="660" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <omgdi:waypoint x="770" y="100" />
        <omgdi:waypoint x="800" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <omgdi:waypoint x="910" y="100" />
        <omgdi:waypoint x="940" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <omgdi:waypoint x="585" y="205" />
        <omgdi:waypoint x="585" y="280" />
        <omgdi:waypoint x="660" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <omgdi:waypoint x="770" y="280" />
        <omgdi:waypoint x="800" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <omgdi:waypoint x="910" y="280" />
        <omgdi:waypoint x="940" y="280" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
