<?xml version="1.0" encoding="UTF-8"?>
<!--
  Proceso unificado de compra en SauceDemo (https://www.saucedemo.com).
  Une los modelos bpmn/opcionB_saucedemo_login, _carrito y _checkout en un solo proceso.
  - userTask / manualTask  = acciones que hace el usuario (columnas de la tabla de flujos).
  - serviceTask            = acciones del sistema (el generador las ignora, como en el paper).
  - Flow_17 ("Corregir datos") crea un ciclo para ejercitar el delimitador de recursion.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SauceDemo"
                  targetNamespace="http://uabc.mx/verificacion/saucedemo">
  <bpmn:process id="Process_SauceDemo" name="Compra SauceDemo" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Usuario abre saucedemo.com" />

    <bpmn:userTask id="UT_Login" name="Ingresar usuario y contrasena" />
    <bpmn:serviceTask id="ST_Auth" name="Validar credenciales" />
    <bpmn:exclusiveGateway id="Gw_Login" name="Credenciales validas?" />

    <!-- Rama: usuario bloqueado -->
    <bpmn:manualTask id="MT_Locked" name="Verificar mensaje de usuario bloqueado" />
    <bpmn:endEvent id="End_Locked" name="Acceso denegado" />

    <!-- Rama: compra -->
    <bpmn:userTask id="UT_AddCart" name="Agregar producto al carrito" />
    <bpmn:userTask id="UT_OpenCart" name="Abrir el carrito" />
    <bpmn:userTask id="UT_Checkout" name="Iniciar checkout" />
    <bpmn:userTask id="UT_FillForm" name="Capturar datos de envio" />
    <bpmn:exclusiveGateway id="Gw_Form" name="Datos validos?" />
    <bpmn:userTask id="UT_Finish" name="Confirmar la orden" />
    <bpmn:serviceTask id="ST_Order" name="Registrar la orden" />
    <bpmn:manualTask id="MT_Thanks" name="Verificar mensaje de agradecimiento" />
    <bpmn:endEvent id="End_OK" name="Orden completada" />

    <!-- Rama: error de validacion del formulario -->
    <bpmn:manualTask id="MT_FormError" name="Verificar mensaje de error del formulario" />
    <bpmn:exclusiveGateway id="Gw_Retry" name="Corregir datos?" />
    <bpmn:endEvent id="End_FormError" name="Checkout abandonado" />

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UT_Login" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UT_Login" targetRef="ST_Auth" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ST_Auth" targetRef="Gw_Login" />
    <bpmn:sequenceFlow id="Flow_4" name="standard_user" sourceRef="Gw_Login" targetRef="UT_AddCart" />
    <bpmn:sequenceFlow id="Flow_5" name="locked_out_user" sourceRef="Gw_Login" targetRef="MT_Locked" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="MT_Locked" targetRef="End_Locked" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="UT_AddCart" targetRef="UT_OpenCart" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="UT_OpenCart" targetRef="UT_Checkout" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="UT_Checkout" targetRef="UT_FillForm" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UT_FillForm" targetRef="Gw_Form" />
    <bpmn:sequenceFlow id="Flow_11" name="Si" sourceRef="Gw_Form" targetRef="UT_Finish" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="UT_Finish" targetRef="ST_Order" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ST_Order" targetRef="MT_Thanks" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="MT_Thanks" targetRef="End_OK" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gw_Form" targetRef="MT_FormError" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="MT_FormError" targetRef="Gw_Retry" />
    <bpmn:sequenceFlow id="Flow_17" name="Si" sourceRef="Gw_Retry" targetRef="UT_FillForm" />
    <bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="Gw_Retry" targetRef="End_FormError" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_SauceDemo">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="40" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_Login_di" bpmnElement="UT_Login"><dc:Bounds x="120" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_Auth_di" bpmnElement="ST_Auth"><dc:Bounds x="270" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Login_di" bpmnElement="Gw_Login" isMarkerVisible="true"><dc:Bounds x="420" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MT_Locked_di" bpmnElement="MT_Locked"><dc:Bounds x="520" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Locked_di" bpmnElement="End_Locked"><dc:Bounds x="680" y="322" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_AddCart_di" bpmnElement="UT_AddCart"><dc:Bounds x="520" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_OpenCart_di" bpmnElement="UT_OpenCart"><dc:Bounds x="670" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_Checkout_di" bpmnElement="UT_Checkout"><dc:Bounds x="820" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_FillForm_di" bpmnElement="UT_FillForm"><dc:Bounds x="970" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Form_di" bpmnElement="Gw_Form" isMarkerVisible="true"><dc:Bounds x="1120" y="175" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UT_Finish_di" bpmnElement="UT_Finish"><dc:Bounds x="1220" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_Order_di" bpmnElement="ST_Order"><dc:Bounds x="1370" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MT_Thanks_di" bpmnElement="MT_Thanks"><dc:Bounds x="1520" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OK_di" bpmnElement="End_OK"><dc:Bounds x="1670" y="182" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MT_FormError_di" bpmnElement="MT_FormError"><dc:Bounds x="1220" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Retry_di" bpmnElement="Gw_Retry" isMarkerVisible="true"><dc:Bounds x="1370" y="315" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FormError_di" bpmnElement="End_FormError"><dc:Bounds x="1480" y="322" width="36" height="36" /></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="76" y="200" /><di:waypoint x="120" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="220" y="200" /><di:waypoint x="270" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="370" y="200" /><di:waypoint x="420" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="470" y="200" /><di:waypoint x="520" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="445" y="225" /><di:waypoint x="445" y="340" /><di:waypoint x="520" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="620" y="340" /><di:waypoint x="680" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="620" y="200" /><di:waypoint x="670" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="770" y="200" /><di:waypoint x="820" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="920" y="200" /><di:waypoint x="970" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1070" y="200" /><di:waypoint x="1120" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1170" y="200" /><di:waypoint x="1220" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1320" y="200" /><di:waypoint x="1370" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1470" y="200" /><di:waypoint x="1520" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1620" y="200" /><di:waypoint x="1670" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1145" y="225" /><di:waypoint x="1145" y="340" /><di:waypoint x="1220" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1320" y="340" /><di:waypoint x="1370" y="340" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="1395" y="365" /><di:waypoint x="1395" y="420" /><di:waypoint x="1020" y="420" /><di:waypoint x="1020" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="1420" y="340" /><di:waypoint x="1480" y="340" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
